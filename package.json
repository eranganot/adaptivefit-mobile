{
  "name": "adaptivefit-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Personal training PWA \u2014 runner rehab + AI coach (Gemini). Single-user Next.js + Postgres on Railway.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed-history": "tsx scripts/seed-history.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "cap": "cap",
    "cap:sync": "cap sync android",
    "cap:sync:dev": "cross-env CAPACITOR_DEV=1 cap sync android",
    "cap:open": "cap open android",
    "cap:run": "cap run android --target",
    "android:install-debug": "adb install -r android/app/build/outputs/apk/debug/app-debug.apk"
  },
  "dependencies": {
    "@capacitor-community/background-geolocation": "^1.3.1",
    "@capacitor/android": "^6.2.3",
    "@capacitor/core": "^6.2.3",
    "@capacitor/geolocation": "^6.1.1",
    "@capacitor/local-notifications": "^6.1.0",
    "@google/generative-ai": "^0.24.1",
    "@hookform/resolvers": "^3.9.0",
    "@kiwi-health/capacitor-health-connect": "^0.0.43",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^0.460.0",
    "mapbox-gl": "^3.34.2",
    "motion": "^12.7.3",
    "next": "15.5.29",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "^3.25.0",
    "next-pwa": "^5.6.0",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.91.0",
    "recharts": "^2.13.3",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.2.1",
    "@types/mapbox-gl": "^3.4.2",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.14.0",
    "eslint-config-next": "15.5.29",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "pnpm@9.12.3",
  "pnpm": {
    "overrides": {
      "brace-expansion@<2": "^1.1.21",
      "brace-expansion@>=2 <3": "^2.1.7",
      "brace-expansion@>=3 <6": "^5.0.12",
      "fast-uri@>=3 <4": "^3.1.9",
      "nanoid@<4": "^3.3.20",
      "serialize-javascript@<7.0.3": "^7.1.4",
      "source-map-js@<1.2.2": "^1.2.2",
      "browserslist@<4.28.7": "^4.29.5",
      "@babel/plugin-transform-modules-systemjs@<7.29.4": "^7.29.8",
      "postcss@<8.5.18": "^8.5.32"
    }
  }
}
