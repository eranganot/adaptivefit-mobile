# ──────────────────────────────────────────────────────────────────
# AdaptiveFit Mobile — environment template
# Copy to `.env` for local dev. Never commit `.env`.
# In Railway, set the same vars under the service's Variables tab.
# ──────────────────────────────────────────────────────────────────

# Database — Railway Postgres injects this automatically in production.
DATABASE_URL="postgresql://user:pass@localhost:5432/adaptivefit"

# Auth.js (NextAuth v5)
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Google OAuth — create at https://console.cloud.google.com → APIs & Services → Credentials
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google (dev)
#                          https://<your-railway-domain>/api/auth/callback/google (prod)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Single-user lockdown — only this email can sign in.
# Set to your Google account email. Leave empty to allow any signed-in user (NOT recommended).
ALLOWED_EMAIL="eran.ganot@gmail.com"

# Gemini — get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""
# Models used. Override per-task if needed.
# NOTE: gemini-1.5-* is deprecated. Use 2.5 or later.
GEMINI_MODEL_FAST="gemini-2.5-flash"
GEMINI_MODEL_DEEP="gemini-2.5-pro"

# Public app URL (used for OAuth callback config + PWA manifest)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Mapbox GL — required for GPS active-run map (Phase 2)
# Get a free token at https://account.mapbox.com → Tokens → Create a token
# Scope needed: styles:read, tiles:read (default public token is fine)
# Must be NEXT_PUBLIC_ so the browser can access it.
NEXT_PUBLIC_MAPBOX_TOKEN=""
