<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Health Connect: the permission rationale intent. When the user -->
            <!-- taps "Why does AdaptiveFit need this?" in Health Connect's     -->
            <!-- permission dialog, Android opens the activity that handles    -->
            <!-- this action. Pointing it at MainActivity sends them back into -->
            <!-- our app, where the Settings page explains it. Required by    -->
            <!-- Google's Health Connect data-types policy.                    -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- Health Connect also needs an activity-alias variant of the -->
        <!-- rationale intent on Android 13. Standard alias declaration. -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- ── Location ─────────────────────────────────────────────────── -->
    <!-- FINE: GPS-quality location (we always want this for run tracking). -->
    <!-- COARSE: required as a fallback by the Android Location framework -->
    <!--   even when we ask for FINE. -->
    <!-- BACKGROUND: lets us keep tracking after the screen locks / app is -->
    <!--   backgrounded. On Android 11+ this MUST be requested separately, -->
    <!--   AFTER foreground location is already granted (we handle that UX -->
    <!--   in the pre-run permission flow). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- ── Foreground service (background-geolocation plugin) ──────────── -->
    <!-- The plugin runs as an Android foreground service while a run is -->
    <!-- active. Required so the OS doesn't suspend our process when the -->
    <!-- screen locks. Comes with a persistent notification (Android -->
    <!-- requirement — no way to hide it). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14+ requires declaring the *type* of foreground service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Android 13+ requires runtime permission to post notifications -->
    <!-- (including the foreground-service notification). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- WAKE_LOCK keeps the CPU running so GPS callbacks fire while the -->
    <!-- screen is off. The plugin uses this internally. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- ── Local notifications (workout reminders) ────────────────────── -->
    <!-- @capacitor/local-notifications declares POST_NOTIFICATIONS (already -->
    <!-- present above for the foreground-service notification) and its own -->
    <!-- AlarmReceiver / boot receiver. We add the exact-alarm permissions   -->
    <!-- here so scheduled reminders fire at the precise minute instead of    -->
    <!-- being batched by Doze. SCHEDULE_EXACT_ALARM covers Android 12 (API   -->
    <!-- 31); USE_EXACT_ALARM covers Android 13+ (API 33+) and is auto-granted -->
    <!-- — Play Store restricts USE_EXACT_ALARM to alarm/calendar apps, but    -->
    <!-- this app is sideloaded (single-user), so it's fine here.             -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- Re-arm scheduled reminders after a device reboot. The plugin's       -->
    <!-- LocalNotificationRestoreReceiver listens for BOOT_COMPLETED; without  -->
    <!-- this permission Android won't deliver that broadcast.                -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Required feature declaration — Play Store filter, also a hint to -->
    <!-- the OS that we're a location-aware app. -->
    <uses-feature android:name="android.hardware.location.gps" android:required="true" />

    <!-- ── Health Connect (Phase 8) ─────────────────────────────────── -->
    <!-- Each data type we read requires its own permission. We declare    -->
    <!-- a minimal set for the MVP: steps, distance, calories, heart rate. -->
    <!-- ExerciseSession comes in Phase 8b.                                -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_TOTAL_CALORIES_BURNED" />
    <!-- READ_EXERCISE re-added in Phase 8b.5. The earlier 8b.1 revert was      -->
    <!-- pre-emptive — the kiwi-health plugin v0.0.40 DOES register             -->
    <!-- ExerciseSession in its RecordTypeRegistry (line 22 of                  -->
    <!-- RecordTypeRegistry.kt). The 8b.1 crash was likely a different issue   -->
    <!-- that's since been fixed by Health Connect platform updates over the   -->
    <!-- last 18 months. Without this manifest entry, HC's permission Activity -->
    <!-- silently skips ExerciseSession (returns "No requestable permission   -->
    <!-- in the request") because Android requires every HC permission to be  -->
    <!-- declared statically — even if the plugin sends it in the request,    -->
    <!-- HC checks the manifest before prompting.                              -->
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <!--                                                                       -->
    <!-- READ_HEART_RATE remains out (plugin's RecordTypeRegistry doesn't      -->
    <!-- include HeartRate). Revisits in Phase 8b.6 if we fork the plugin.    -->

    <!-- Health Connect's package-visibility query (Android 11+). Without  -->
    <!-- this, our app can't even detect whether Health Connect is        -->
    <!-- installed because Android hides other apps' presence by default. -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
        <intent>
            <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
        </intent>
    </queries>
</manifest>
