# pnpm: hoist all packages to the top-level node_modules so webpack/Next.js
# (running on Railway's Nixpacks builder) can resolve them via standard
# Node resolution. Without this, pnpm's symlinked .pnpm/ layout can leave
# Capacitor plugins unreachable to `require()` / `import()` during the
# Next.js production build, even though they're physically present.
shamefully-hoist=true

# Don't fail builds on peer-dep warnings — Capacitor's plugin ecosystem
# sometimes declares broader peer ranges than what's installed.
strict-peer-dependencies=false
